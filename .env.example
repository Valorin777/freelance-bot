# --- Telegram user-сессия для парсера (my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Путь к файлу сессии Telethon (создастся при первом запуске)
TELETHON_SESSION=data/telethon_session

# Каналы для мониторинга, через запятую. Можно @username или ссылку t.me
TELEGRAM_CHANNELS=@frilanc,@rabotafrontend

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Модель для фильтрации заказов
FILTER_MODEL=claude-sonnet-4-6
# Модель для генерации черновиков откликов
GENERATOR_MODEL=claude-sonnet-4-6

# --- Firebase ---
# Путь к JSON сервисного аккаунта (Firebase Console -> Project settings -> Service accounts)
FIREBASE_CREDENTIALS=./firebase-service-account.json

# --- Бот для уведомлений (@BotFather) ---
BOT_TOKEN=123456789:AAE...
# Ваш личный chat id. Если не знаете — оставьте 0, запустите бота,
# отправьте ему /start: он покажет ваш id. Потом впишите сюда и перезапустите.
TELEGRAM_CHAT_ID=0
